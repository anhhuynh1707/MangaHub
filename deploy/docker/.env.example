# Copy to deploy/docker/.env.local for local production-style testing, or to a
# protected server-side .env for EC2. Never commit the copied file.

# Use exact immutable SHA tags after CI publishes production images.
MANGAHUB_IMAGE=ghcr.io/anhhuynh1707/mangahub:sha-0123456789abcdef0123456789abcdef01234567
MANGAHUB_FRONTEND_IMAGE=ghcr.io/anhhuynh1707/mangahub-frontend:sha-0123456789abcdef0123456789abcdef01234567

# Generate with: openssl rand -base64 48
JWT_SECRET=

# Local production-style test defaults. On EC2 use HOST_HTTP_PORT=80 and replace
# PUBLIC_ORIGIN with the instance's current public IPv4 URL.
HOST_HTTP_PORT=8088
PUBLIC_ORIGIN=http://localhost:8088
LOG_LEVEL=info

# Used only with docker-compose.raw.yml. Keep 127.0.0.1 locally. On EC2,
# 0.0.0.0 is allowed only while the AWS Security Group restricts these ports to
# the owner's current public IPv4 /32.
RAW_BIND_ADDRESS=127.0.0.1
