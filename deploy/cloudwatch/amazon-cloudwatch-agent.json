{
  "agent": {
    "debug": false,
    "metrics_collection_interval": 60,
    "region": "ap-southeast-2"
  },
  "metrics": {
    "namespace": "MangaHub/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "drop_device": true,
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60,
        "resources": [
          "/"
        ]
      },
      "mem": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": 60
      }
    }
  }
}
